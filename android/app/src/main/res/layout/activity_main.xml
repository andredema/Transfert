<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/defilement"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Connexion -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ordinateur"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/champAdresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adresse du PC (ex. 192.168.1.20:8765)"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/champJeton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jeton affiché par le serveur"
            android:inputType="textCapCharacters"
            android:singleLine="true" />

        <Button
            android:id="@+id/boutonTester"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tester la connexion" />

        <!-- Dossier -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Dossier du téléphone à transférer"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/listeDossiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/champDossier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="/storage/emulated/0/DCIM/Camera"
            android:inputType="textUri"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/caseSousDossiers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Inclure les sous-dossiers" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seulement les fichiers de plus de " />

            <EditText
                android:id="@+id/champAge"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:text="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" jours (0 = tous)" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/caseSupprimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Supprimer du téléphone après vérification" />

        <!-- Actions -->
        <Button
            android:id="@+id/boutonPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Autoriser l'accès aux fichiers" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/boutonDemarrer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Démarrer" />

            <Button
                android:id="@+id/boutonArreter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Arrêter" />
        </LinearLayout>

        <!-- Suivi -->
        <ProgressBar
            android:id="@+id/barreProgression"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="1000" />

        <TextView
            android:id="@+id/texteStatut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Prêt."
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texteJournal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
